# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Which LLM backend to use. Currently only 'gemini' is supported.
# To add a new provider implement backend/llm/<provider>_client.py and update
# backend/llm/provider.py.
LLM_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google Gemini (default provider)
# ---------------------------------------------------------------------------
# Free key from https://aistudio.google.com — required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (optional)
# ---------------------------------------------------------------------------
# Override the backend base URL when running outside the Vite dev proxy.
# Leave empty for local development (proxy is configured in vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8000
